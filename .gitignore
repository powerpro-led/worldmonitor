# Generated by `npm run build:sidecar-handlers` from the api/<name>.ts sibling —
# build output for the sidecar's route table, never source. Same treatment as
# api/*/v1/[rpc].js and api/mcp.js above. Regenerate this list with:
#   ls api/*.ts | grep -vE '/(_|\[)|\.(test|d)\.ts$' | sed 's/\.ts$/.js/'
api/a2a.js
api/agent-auth.js
api/ask.js
api/chat-analyst.js
api/followed-countries.js
api/http-message-signatures-directory.js
api/latest-brief.js
api/mcp-proxy.js
api/not-found.js
api/notification-channels.js
api/notify.js
api/oauth-authorization-server.js
api/oauth-protected-resource.js
api/seed-contract-probe.js
api/symbol-search.js
api/user-prefs.js
api/widget-agent.js

# transient: test:sidecar points LOCAL_CONFIG_DB_PATH here (never actually written)
.test-no-config.db

# Supabase CLI local link state (project ref, pooler URL, version cache) —
# written by `supabase link` / `supabase secrets set`. Never canonical repo
# config; each dev's local link target differs.
supabase/.temp/
