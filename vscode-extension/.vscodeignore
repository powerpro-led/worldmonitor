src/**
node_modules/**
.gitignore
esbuild.js
tsconfig.json
*.map
.vscode-test/**

# The whole sidecar/ backend now ships and runs as a standalone launchd
# service via `worldmonitor-local install` — the extension is a pure client
# (src/backendClient.ts) and never spawns any of it. Packaging it into the
# .vsix would only bloat the artifact and, worse, bake in whoever built it
# real synced brief data (local-cache.db) + Supabase identity
# (operator-identity.json / session.json) — the packaging-time form of
# session 39's per-user brief: scoping leak. vsce reads THIS file instead of
# .gitignore once it exists, so the exclusion has to live here.
sidecar/**
