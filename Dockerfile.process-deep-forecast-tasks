# =============================================================================
# Deep Forecast Worker (always-on Railway service — NOT a cron)
# =============================================================================
# Runs scripts/process-deep-forecast-tasks.mjs, which without --once (the
# invocation used here) polls scripts/seed-forecasts.mjs's exported
# runDeepForecastWorker() in a `for (;;) { ...; await sleep(...); }` loop.
# Sibling of process-simulation-tasks.mjs — same seed-forecasts.mjs backing
# module, same discovery: scripts/railway-services.json's
# `deployMode: "nixpacks-root-scripts"` for this entry does NOT mean
# periodic cron the way most nixpacks-* entries do (found 2026-08-06 while
# filling in gcp/scheduler/main.ts's cadences; see
# docs/architecture/nitric-gcp-scaffold.md). See Dockerfile.process-
# simulation-tasks for the full "ship whole scripts/ tree" rationale — kept
# as a separate image (not merged with that one) to match this repo's
# one-Dockerfile-per-Railway-service convention and because the two workers
# scale/fail independently in production.
#
# Required env (Railway/Cloud Run service vars):
#   UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN
#   OPENROUTER_API_KEY, GROQ_API_KEY   (forecast LLM calls — callForecastLLM)
# Optional:
#   FORECAST_LLM_*_PROVIDER_ORDER / FORECAST_LLM_*_MODEL_OPENROUTER  (routing overrides)
#   AXIOM_API_TOKEN     (usage telemetry)
#   WM_API_BASE_URL, WORLDMONITOR_RELAY_KEY
# =============================================================================

FROM node:24-alpine@sha256:a0b9bf06e4e6193cf7a0f58816cc935ff8c2a908f81e6f1a95432d679c54fbfd

WORKDIR /app

# Install scripts/ runtime dependencies (@aws-sdk/client-s3 for _r2-storage.mjs, etc.)
COPY scripts/package.json scripts/package-lock.json ./scripts/
RUN npm ci --prefix scripts --omit=dev

# Ship the full scripts/ tree — see Dockerfile.process-simulation-tasks for rationale.
COPY scripts/ ./scripts/
COPY shared/ ./shared/

ENV NODE_OPTIONS="--max-old-space-size=1024 --dns-result-order=ipv4first"

# No --once: this is the always-on poll-loop invocation, matching how
# Railway runs it today.
CMD ["node", "scripts/process-deep-forecast-tasks.mjs"]
